API_HOST=127.0.0.1
API_PORT=8000

# LLM 提供方：mock = 纯规则（零依赖、零延迟、免 key）；openai = OpenAI 兼容 API
LLM_PROVIDER=mock

# 推荐 DeepSeek（便宜、国内直连、OpenAI 兼容）：
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
# 或 OpenAI / Moonshot(Kimi) 等任何 OpenAI 兼容服务，只改下面三项即可
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1

VITE_API_BASE_URL=http://127.0.0.1:8000
